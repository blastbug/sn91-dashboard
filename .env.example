TAOSTATS_API_KEY=your_taostats_api_key_here
SUBNET_NETUID=91
PORT=3000

# --- Taostats budget (defaults are tuned for the FREE tier: 5 calls/min, 10,000/month) ---
# Cache lifetimes, not page refresh rate, are what consume credits: a reload
# inside a TTL is served from cache for free. Defaults spend ~12 calls/hour
# (~8,640/month), which fits the free allowance with headroom.
# Lower these only if you are on a paid plan.
# TTL_SUBNET_MS=600000       # 10 min  -> 6 calls/hr
# TTL_METAGRAPH_MS=1200000   # 20 min  -> 3 calls/hr
# TTL_EVENTS_MS=3600000      # 60 min  -> 3 calls/hr (3 endpoints)
# TAOSTATS_MIN_GAP_MS=12000  # 5 calls/min ceiling = one call per 12s

# --- Live stream (free: the Cascade receipt store is unmetered) ---
# How often the server re-reads the receipt store and pushes changed sections to
# connected browsers. One poll here serves every open tab, so this can be tight
# without the upstream cost growing with the audience. Lower than ~5s is wasted:
# the trainer republishes its status documents about once a minute.
# LIVE_INTERVAL_MS=10000
